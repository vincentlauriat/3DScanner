    "error.roomplan.insufficient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough of the room was captured. Walk along every wall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce n'a pas été assez couverte. Longez chaque mur."
          }
        }
      }
    },
    "error.roomplan.lowTexture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces are too uniform: turn on the lights or move closer to the walls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces trop uniformes : allumez la lumière ou approchez-vous des murs."
          }
        }
      }
    },
    "error.roomplan.tooHot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone is too hot: let it cool down for a minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'iPhone chauffe : laissez-le refroidir une minute."
          }
        }
      }
    },
    "error.roomplan.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room is too large for a single scan. Scan it in two parts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce est trop grande pour un seul scan. Scannez-la en deux parties."
          }
        }
      }
    },
    "error.roomplan.trackingLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking was lost: start again and move more slowly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi perdu : recommencez en bougeant plus lentement."
          }
        }
      }
