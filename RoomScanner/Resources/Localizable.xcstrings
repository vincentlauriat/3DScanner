    "error.roomplan.insufficient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough of the room was captured. Walk along every wall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce n'a pas été assez couverte. Longez chaque mur."
          }
        }
      }
    },
    "error.roomplan.lowTexture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces are too uniform: turn on the lights or move closer to the walls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces trop uniformes : allumez la lumière ou approchez-vous des murs."
          }
