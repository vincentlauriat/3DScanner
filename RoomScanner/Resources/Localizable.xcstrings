    "settings.icloud.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With iCloud Drive, rooms and exports live in the “3D Scanner” folder (Files, Finder), shared between iPhone and Mac. Turning it off deletes nothing: the app goes back to the device’s local folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec iCloud Drive, vos pièces et exports sont dans le dossier « 3D Scanner » (Fichiers, Finder) et partagés entre iPhone et Mac. Désactiver ne supprime rien : l’app revient au dossier local de l’appareil."
          }
        }
      }
    },
