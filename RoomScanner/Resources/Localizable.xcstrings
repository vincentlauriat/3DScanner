    "cloud.status.localNoAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iCloud account: rooms stay on this device. Sign in to iCloud to share them with your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte iCloud : les pièces restent sur cet appareil. Connectez-vous à iCloud pour les partager avec votre Mac."
          }
        }
      }
    },
    "cloud.status.localNoContainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive unavailable (disabled or missing container): rooms stay on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
