      }
    },
    "error.roomplan.tooHot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone is too hot: let it cool down for a minute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'iPhone chauffe : laissez-le refroidir une minute."
